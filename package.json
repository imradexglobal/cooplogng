{
  "name": "cooperative_log_app_web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "Imradex Global",
  "description": "CoopLog - cooperative savings, loans and remittance manager",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/auto-share-allocation.test.mjs tests/auto-share-status.test.mjs tests/loan-advice.test.mjs && node scripts/test-pack.mjs && node scripts/test-general-asset.mjs && node scripts/build-workbook.mjs && node scripts/width-check.mjs",
    "test:auto-share": "node --test tests/auto-share-allocation.test.mjs tests/auto-share-status.test.mjs",
    "test:loan-advice": "node --test tests/loan-advice.test.mjs",
    "test:pack": "node scripts/test-pack.mjs",
    "test:general-asset": "node scripts/test-general-asset.mjs",
    "test:workbook": "node scripts/build-workbook.mjs",
    "test:widths": "node scripts/width-check.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "inspect:workbook": "node scripts/build-workbook.mjs && node scripts/inspect-workbook.mjs",
    "backfill-search-keys": "node scripts/backfill-search-keys.mjs",
    "electron:dev": "electron .",
    "electron:test": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "publish:desktop": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "electron-updater": "^6.3.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.2.1",
    "firebase-admin": "^14.4.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "firebase-tools": "^15.17.0",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild": true,
    "electron": true,
    "re2": true,
    "protobufjs": true,
    "@firebase/util": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adebowaleabdulwasiu00/cooplogng.git"
  },
  "keywords": [],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/adebowaleabdulwasiu00/cooplogng/issues"
  },
  "homepage": "https://github.com/adebowaleabdulwasiu00/cooplogng#readme"
}
